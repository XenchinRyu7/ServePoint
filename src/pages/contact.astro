---
import Layout from '../layouts/Layout.astro';
import Announcement from '../components/Announcement.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact Us - ServePoint AI">
  <Announcement />
  <Navbar />

  <main class="flex-grow">
    <!-- Header Banner -->
    <section class="py-16 md:py-24 bg-slate-900 text-white relative overflow-hidden">
      <div class="absolute top-0 right-0 w-96 h-96 bg-brand-emerald/10 blur-[120px] rounded-full pointer-events-none"></div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4 relative z-10">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-800 border border-slate-700 text-emerald-400 text-xs font-mono font-bold uppercase tracking-wider">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 text-emerald-400">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.147-5.144-3.467-6.291-6.291l1.293-.97c.362-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          HUBUNGI KAMI
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white">
          Siap Konsultasi & Jadwalkan <span class="text-brand-emerald">Live Demo Resto?</span>
        </h1>
        <p class="text-slate-400 text-base md:text-lg max-w-2xl mx-auto font-medium">
          Tim spesialis F&B AI kami siap menjawab pertanyaan Anda dan menguji coba unit fisik tablet ServePoint langsung di outlet Anda.
        </p>
      </div>
    </section>

    <!-- Main Contact & Inquiry Form Grid -->
    <section class="py-20 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
          
          <!-- Left Column: Direct Contact Info & Fast Response -->
          <div class="lg:col-span-5 space-y-8">
            <div class="space-y-3">
              <span class="text-xs font-mono font-bold text-brand-emerald uppercase tracking-wider">FAST RESPONSE SUPPORT</span>
              <h2 class="text-2xl font-extrabold text-brand-obsidian">Hubungi Tim Sales & Engineering</h2>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-medium">
                Dapatkan penawaran khusus bundling hardware tablet, pendaftaran gratis biaya instalasi, atau tanya jawab teknis POS.
              </p>
            </div>

            <!-- Contact Method Cards -->
            <div class="space-y-4">
              
              <!-- WhatsApp Fast Response -->
              <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-start gap-4">
                <div class="h-10 w-10 rounded-xl bg-emerald-50 text-brand-emerald border border-emerald-100 flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a.75.75 0 01-1.074-.707V19a5.976 5.976 0 01-1.336-3.75C3 10.7 7.03 7 12 7s9 3.7 9 8.25z" />
                  </svg>
                </div>
                <div>
                  <div class="text-xs font-bold text-slate-400 uppercase">WhatsApp Live Chat (Respon &lt; 15m)</div>
                  <div class="text-sm font-extrabold text-brand-obsidian mt-0.5">+62 812-8899-7700</div>
                  <div class="text-[11px] text-slate-500 font-medium">Senin - Minggu (08.00 - 22.00 WIB)</div>
                </div>
              </div>

              <!-- Email Official -->
              <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-start gap-4">
                <div class="h-10 w-10 rounded-xl bg-amber-50 text-brand-amber border border-amber-100 flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                  </svg>
                </div>
                <div>
                  <div class="text-xs font-bold text-slate-400 uppercase">Email Pertanyaan & Partnership</div>
                  <div class="text-sm font-extrabold text-brand-obsidian mt-0.5">hello@servepoint.ai</div>
                  <div class="text-[11px] text-slate-500 font-medium">Proposal franchise & distributor</div>
                </div>
              </div>

              <!-- HQ Address -->
              <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-start gap-4">
                <div class="h-10 w-10 rounded-xl bg-purple-50 text-purple-600 border border-purple-100 flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                  </svg>
                </div>
                <div>
                  <div class="text-xs font-bold text-slate-400 uppercase">Kantor Pusat (HQ)</div>
                  <div class="text-xs font-extrabold text-brand-obsidian mt-0.5">SCBD Tech Tower, Fl 18</div>
                  <div class="text-[11px] text-slate-500 font-medium">Jl. Jend. Sudirman Kav. 52-53, Jakarta Selatan</div>
                </div>
              </div>

            </div>
          </div>

          <!-- Right Column: Interactive Contact Form -->
          <div class="lg:col-span-7 bg-white p-8 md:p-10 rounded-3xl border border-slate-200 shadow-md">
            <h3 class="text-xl font-extrabold text-brand-obsidian mb-2">Formulir Demo & Konsultasi Free</h3>
            <p class="text-xs text-slate-500 font-medium mb-6">
              Isi data outlet Anda di bawah ini. Tim kami akan menghubungi Anda untuk mengatur jadwal demo unit fisik.
            </p>

            <form class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold text-slate-600 mb-1">Nama Lengkap</label>
                  <input 
                    type="text" 
                    required 
                    placeholder="Contoh: Budi Santoso"
                    class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-xs md:text-sm font-semibold outline-none focus:border-brand-emerald focus:bg-white transition-colors"
                  />
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-600 mb-1">Nama Cafe / Restoran</label>
                  <input 
                    type="text" 
                    required 
                    placeholder="Contoh: Kopi Titik Rasa"
                    class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-xs md:text-sm font-semibold outline-none focus:border-brand-emerald focus:bg-white transition-colors"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold text-slate-600 mb-1">Kota Outlet</label>
                  <input 
                    type="text" 
                    required 
                    placeholder="Contoh: Surabaya / Bandung"
                    class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-xs md:text-sm font-semibold outline-none focus:border-brand-emerald focus:bg-white transition-colors"
                  />
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-600 mb-1">Nomor WhatsApp Active</label>
                  <input 
                    type="tel" 
                    required 
                    placeholder="Contoh: 08123456789"
                    class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-xs md:text-sm font-semibold outline-none focus:border-brand-emerald focus:bg-white transition-colors"
                  />
                </div>
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-600 mb-1">Jumlah Meja Makan</label>
                <select class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-xs md:text-sm font-semibold outline-none focus:border-brand-emerald focus:bg-white transition-colors">
                  <option value="1-10">1 - 10 Meja (Skala Kecil)</option>
                  <option value="11-25">11 - 25 Meja (Skala Menengah)</option>
                  <option value="26-50">26 - 50 Meja (Skala Besar)</option>
                  <option value="50+">Lebih dari 50 Meja (Multi-Outlet Franchise)</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-600 mb-1">Pesan / POS Yang Digunakan</label>
                <textarea 
                  rows="3" 
                  placeholder="Contoh: Kami pakai Moka POS. Tertarik coba fitur RAG gizi untuk pengunjung gym."
                  class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-xs md:text-sm font-semibold outline-none focus:border-brand-emerald focus:bg-white transition-colors"
                ></textarea>
              </div>

              <button 
                type="submit" 
                class="w-full py-4 px-6 bg-brand-amber hover:bg-amber-600 text-white font-extrabold uppercase tracking-wider text-xs md:text-sm rounded-xl shadow-md transition-all duration-200 hover:scale-[1.01]"
              >
                Kirim Permintaan Demo
              </button>

              <p class="text-[10px] text-slate-400 text-center font-medium pt-1">
                🔒 Data Anda terenkripsi aman dan hanya digunakan untuk keperluan konsultasi internal ServePoint.
              </p>
            </form>
          </div>

        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
