---
import Layout from '../layouts/Layout.astro';
import Announcement from '../components/Announcement.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Logos from '../components/Logos.astro';
import BentoFeatures from '../components/BentoFeatures.astro';
import EcosystemTabs from '../components/EcosystemTabs.jsx';
import RoiCalculator from '../components/RoiCalculator.jsx';
import Comparison from '../components/Comparison.astro';
import Pricing from '../components/Pricing.jsx';
import Faq from '../components/Faq.jsx';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <!-- Global Top Announcement Bar -->
  <Announcement />

  <!-- Navigation Bar -->
  <Navbar />

  <main class="flex-grow">
    <!-- Hero Section with Left Text & Right Tablet Mockup Island -->
    <Hero />

    <!-- Partner Logos Cloud -->
    <Logos />

    <!-- Dribbble-style Bento Capabilities Grid -->
    <BentoFeatures />

    <!-- Ecosystem Tab Switcher (Tablet App, KDS, Owner Dashboard) -->
    <EcosystemTabs client:visible />

    <!-- Interactive ROI Calculator Widget -->
    <RoiCalculator client:visible />

    <!-- Comparison Table (Conventional vs QR Scanner vs ServePoint) -->
    <Comparison />

    <!-- Pricing Packages Grid with Monthly/Annual Switcher -->
    <Pricing client:visible />

    <!-- FAQ Accordion Dropdowns -->
    <Faq client:visible />

    <!-- Leads Capture CTA Form with Success State transition -->
    <CtaBanner />
  </main>

  <!-- Footnotes and links -->
  <Footer />
</Layout>
