---
---
<section id="perbandingan" class="py-20 md:py-28 bg-white border-b border-slate-200/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-16 space-y-4">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200/60 text-brand-emerald text-xs font-bold uppercase tracking-wider">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 text-brand-emerald">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.5H5.25A2.25 2.25 0 003 6.75v10.5a2.25 2.25 0 002.25 2.25h13.5A2.25 2.25 0 0021 17.25V6.75A2.25 2.25 0 0018.75 4.5z" />
        </svg>
        MATRIKS PERBANDINGAN
      </div>
      <h2 class="text-3xl md:text-4xl font-extrabold text-brand-obsidian tracking-tight">
        Mengapa ServePoint AI Mengalahkan Metode POS & QR Lama?
      </h2>
      <p class="text-slate-600 font-medium max-w-2xl mx-auto text-sm md:text-base">
        Satu-satunya sistem pemesanan meja di Indonesia dengan <span class="font-bold text-brand-emerald">Custom RAG Engine</span> dan <span class="font-bold text-brand-amber">Informasi Nutrisi Gizi</span> untuk menarik segmen pelanggan fitness & gym.
      </p>
    </div>

    <!-- Comparison Table Grid -->
    <div class="max-w-5xl mx-auto overflow-x-auto">
      <table class="w-full text-left border-collapse min-w-[700px]">
        <thead>
          <tr class="border-b border-slate-200/60">
            <th class="py-5 pr-4 text-xs font-bold text-slate-400 uppercase tracking-wider w-1/4">Fitur & Kapabilitas</th>
            <th class="py-5 px-4 text-xs font-bold text-slate-500 uppercase tracking-wider w-1/4">Pelayan Konvensional</th>
            <th class="py-5 px-4 text-xs font-bold text-slate-500 uppercase tracking-wider w-1/4">QR Code Scanner</th>
            <th class="py-5 px-6 text-xs font-bold text-brand-emerald bg-emerald-50/50 rounded-t-xl uppercase tracking-wider w-1/4 border-t border-x border-slate-200/80">
              ServePoint AI Voice + RAG
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-sm">
          
          <!-- Row 1: Custom RAG & Upload Data Admin -->
          <tr class="bg-emerald-50/20">
            <td class="py-4.5 pr-4 font-extrabold text-brand-emerald flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-amber-600 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
              </svg>
              Custom RAG & Upload Data Admin
            </td>
            <td class="py-4.5 px-4 text-slate-400 font-medium">Tidak Ada (Terbatas hapalan pelayan)</td>
            <td class="py-4.5 px-4 text-slate-400 font-medium">Tidak Ada (Hanya teks menu statis)</td>
            <td class="py-4.5 px-6 text-brand-emerald font-extrabold bg-emerald-50/40 border-x border-slate-200/80 flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-4 h-4 text-brand-emerald shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              Penuh. Admin upload Excel/PDF data resto & gizi.
            </td>
          </tr>

          <!-- Row 2: Info Gizi & Makronutrisi -->
          <tr class="bg-emerald-50/20">
            <td class="py-4.5 pr-4 font-extrabold text-brand-emerald flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-emerald-600 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18z" />
              </svg>
              Info Gizi & Kalori Real-Time
            </td>
            <td class="py-4.5 px-4 text-slate-400 font-medium">Pelayan jarang tahu persis protein/kalori.</td>
            <td class="py-4.5 px-4 text-slate-400 font-medium">Hanya harga statis tanpa breakdown gizi.</td>
            <td class="py-4.5 px-6 text-brand-emerald font-extrabold bg-emerald-50/40 border-x border-slate-200/80 flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-4 h-4 text-brand-emerald shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              Hitung otomatis Protein, Kalori, Karbo & Lemak via AI.
            </td>
          </tr>

          <!-- Row 3: Daya Tarik Komunitas Gym & Health -->
          <tr class="bg-emerald-50/20">
            <td class="py-4.5 pr-4 font-extrabold text-brand-emerald flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-emerald-600 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z" />
              </svg>
              Magnet Pelanggan Gym & Diet
            </td>
            <td class="py-4.5 px-4 text-slate-400 font-medium">Tidak ada nilai tambah khusus.</td>
            <td class="py-4.5 px-4 text-slate-400 font-medium">Tidak ada interaksi konsultasi diet.</td>
            <td class="py-4.5 px-6 text-brand-emerald font-extrabold bg-emerald-50/40 border-x border-slate-200/80 flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-4 h-4 text-brand-emerald shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              Daya tarik sangat tinggi & Nilai Plus Unik untuk Cafe.
            </td>
          </tr>

          <!-- Row 4: Proses Pemesanan -->
          <tr>
            <td class="py-4.5 pr-4 font-bold text-brand-obsidian">Metode Pemesanan</td>
            <td class="py-4.5 px-4 text-slate-500 font-medium">Memanggil pelayan secara manual, menulis di kertas.</td>
            <td class="py-4.5 px-4 text-slate-500 font-medium">Buka kamera, scan QR, buka browser, input OTP WA.</td>
            <td class="py-4.5 px-6 text-slate-800 font-bold bg-emerald-50/30 border-x border-slate-200/80">
              Tinggal bicara alami langsung ke tablet meja.
            </td>
          </tr>

          <!-- Row 5: Kecepatan -->
          <tr>
            <td class="py-4.5 pr-4 font-bold text-brand-obsidian">Waktu Tunggu Order</td>
            <td class="py-4.5 px-4 text-slate-500 font-medium">5-10 menit (menunggu pelayan datang & catat).</td>
            <td class="py-4.5 px-4 text-slate-500 font-medium">3-5 menit (registrasi, loading menu lambat).</td>
            <td class="py-4.5 px-6 text-slate-800 font-bold bg-emerald-50/30 border-x border-slate-200/80">
              Kurang dari 30 detik (pesan instan).
            </td>
          </tr>

          <!-- Row 6: Akurasi & Human Error -->
          <tr>
            <td class="py-4.5 pr-4 font-bold text-brand-obsidian">Akurasi Catatan Kustom</td>
            <td class="py-4.5 px-4 text-slate-500 font-medium">Sering salah catat catatan kustom & alergi.</td>
            <td class="py-4.5 px-4 text-slate-500 font-medium">Akurat namun meletihkan (banyak ngetik).</td>
            <td class="py-4.5 px-6 text-slate-800 font-bold bg-emerald-50/30 border-x border-slate-200/80">
              99% Akurat. Konfirmasi visual di layar.
            </td>
          </tr>

          <!-- Row 7: POS & Kitchen Integration -->
          <tr class="border-b border-slate-200/80">
            <td class="py-4.5 pr-4 font-bold text-brand-obsidian">Sinkronisasi Kasir POS & KDS</td>
            <td class="py-4.5 px-4 text-slate-500 font-medium">Manual diinput ulang oleh kasir (2x kerja).</td>
            <td class="py-4.5 px-4 text-slate-500 font-medium">Butuh langganan modul POS tambahan.</td>
            <td class="py-4.5 px-6 text-slate-800 font-bold bg-emerald-50/30 border-x border-slate-200/80 rounded-b-xl">
              Otomatis kurang dari 1 detik & gratis modul POS.
            </td>
          </tr>

        </tbody>
      </table>
    </div>

    <!-- Call to action card under comparison -->
    <div class="max-w-5xl mx-auto mt-12 p-6 rounded-2xl bg-slate-50 border border-slate-200/85 flex flex-col md:flex-row items-center justify-between gap-6 shadow-sm">
      <div class="text-left space-y-1">
        <h4 class="text-sm font-bold text-brand-obsidian">Ingin membuktikan langsung kemudahannya?</h4>
        <p class="text-xs text-slate-500 font-medium">Kami siap membawakan unit demo fisik ke kafe Anda untuk diuji coba gratis.</p>
      </div>
      <a 
        href="#cta-form" 
        class="inline-flex items-center justify-center py-2.5 px-5 bg-brand-obsidian hover:bg-slate-800 text-white rounded-xl text-xs font-bold transition-colors"
      >
        Jadwalkan Live Demo
      </a>
    </div>

  </div>
</section>
