---
---
<section id="fitur" class="py-20 md:py-28 bg-slate-50 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-16 space-y-4">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200/60 text-brand-emerald text-xs font-bold uppercase tracking-wider">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 text-brand-emerald">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
        </svg>
        KAPABILITAS AI TERDEPAN
      </div>
      <h2 class="text-3xl md:text-4xl font-extrabold text-brand-obsidian tracking-tight">
        Arsitektur Restoran Pintar dengan Custom RAG Engine
      </h2>
      <p class="text-slate-600 font-medium text-slate-600 max-w-2xl mx-auto">
        Kombinasi asisten suara meja, integrasi data gizi makanan, dan kontrol penuh admin restoran untuk mengatur flow jawaban AI.
      </p>
    </div>

    <!-- Bento Grid Container -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Card 1: Large (Span 2 columns) - Custom RAG & Voice AI Admin Control -->
      <div class="md:col-span-2 bg-white rounded-2xl border border-slate-200/80 p-8 shadow-sm flex flex-col justify-between group hover:shadow-md transition-all duration-300">
        <div>
          <span class="inline-flex items-center justify-center h-10 w-10 rounded-xl bg-emerald-50 text-brand-emerald border border-emerald-100 mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5.5 h-5.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" />
            </svg>
          </span>
          <h3 class="text-xl font-bold text-brand-obsidian">Custom RAG: Admin Kendalikan Data & Jawaban AI</h3>
          <p class="text-slate-500 text-sm mt-2 max-w-lg">
            Unggah file resep, menu, dan aturan khusus resto Anda. Admin dapat mengkustomisasi flow respon AI, promosi yang disarankan, serta menangani instruksi unik pelanggan (seperti request alergen atau catatan porsi).
          </p>
        </div>

        <!-- Visual representation of RAG NLP & Admin Custom Rules -->
        <div class="mt-8 bg-slate-50 rounded-xl p-5 border border-slate-200/50 space-y-4">
          
          <!-- Admin RAG Data Pill -->
          <div class="flex items-center justify-between bg-white px-3 py-2 rounded-lg border border-slate-200 text-xs text-slate-700 font-semibold shadow-xs">
            <span class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-slate-500">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m3.75 9v6m3-3H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
              </svg>
              RAG Dataset: <code class="bg-slate-100 px-1.5 py-0.5 rounded text-slate-800 text-[10px]">menu_gizi_resep_v2.xlsx</code>
            </span>
            <span class="text-[10px] text-brand-emerald bg-emerald-50 px-2 py-0.5 rounded font-bold">Terhubung</span>
          </div>

          <!-- Customer spoken input -->
          <div class="flex items-start gap-3">
            <div class="bg-slate-200 text-slate-700 h-6 w-6 rounded-full flex items-center justify-center text-[10px] font-bold shrink-0 mt-0.5">CS</div>
            <div class="bg-white px-3 py-2 rounded-lg border border-slate-200/80 text-xs text-slate-700 leading-relaxed font-medium">
              "Mbak, pesen <span class="bg-orange-100 text-brand-amber px-1 rounded font-bold">Es Kopi Aren dua</span>, yang satu <span class="bg-emerald-100 text-brand-emerald px-1 rounded font-bold">less sugar</span>. Sama ada <span class="bg-purple-100 text-purple-700 px-1 rounded font-bold">menu makanan tinggi protein untuk diet</span>?"
            </div>
          </div>
          
          <!-- Arrow Indicator -->
          <div class="flex justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5 text-slate-400">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
            </svg>
          </div>

          <!-- Structured mapping output -->
          <div class="bg-[#090D16] rounded-lg p-4 font-mono text-[11px] text-emerald-400 space-y-1.5 border border-slate-800 shadow-inner">
            <div class="text-slate-500">// Output AI Berdasarkan Custom RAG Admin:</div>
            <div>&#123;"pesanan": [</div>
            <div class="pl-4">&#123;"nama": <span class="text-white">"Es Kopi Susu Aren"</span>, "qty": <span class="text-white">1</span>, "gula": <span class="text-white">"Normal"</span>&#125;,</div>
            <div class="pl-4">&#123;"nama": <span class="text-white">"Es Kopi Susu Aren"</span>, "qty": <span class="text-white">1</span>, "gula": <span class="text-emerald-300">"Less Sugar (50%)"</span>&#125;</div>
            <div>],</div>
            <div class="text-amber-300">&#123;"rekomendasi_rag": <span class="text-white">"Grilled Salmon Quinoa (Protein: 42g, 480 kcal)"</span>&#125;</div>
          </div>
        </div>
      </div>

      <!-- Card 2: Medium (Span 1 column) - Smart Digital Menu with Nutrition Breakdown -->
      <div class="bg-white rounded-2xl border border-slate-200/80 p-8 shadow-sm flex flex-col justify-between group hover:shadow-md transition-all duration-300">
        <div>
          <span class="inline-flex items-center justify-center h-10 w-10 rounded-xl bg-orange-50 text-brand-orange border border-orange-100 mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5.5 h-5.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 107.5 7.5h-7.5V6z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0013.5 3v7.5z" />
            </svg>
          </span>
          <h3 class="text-xl font-bold text-brand-obsidian">Menu, Harga & Rincian Gizi</h3>
          <p class="text-slate-500 text-sm mt-2">
            Tampilkan harga, foto menarik, dan breakdown gizi lengkap (Kalori, Protein, Karbo, Lemak) secara transparan.
          </p>
        </div>

        <!-- Visual Dish Card Mockup with Nutrients -->
        <div class="mt-8 bg-slate-50 rounded-xl p-4 border border-slate-200/50 space-y-3">
          <div class="bg-white rounded-lg p-3.5 border border-slate-200/60 shadow-sm relative overflow-hidden space-y-2.5">
            <div class="flex justify-between items-start">
              <div>
                <span class="text-[9px] font-extrabold uppercase bg-emerald-50 text-brand-emerald border border-emerald-200 px-1.5 py-0.5 rounded">High Protein</span>
                <h4 class="text-xs font-bold text-brand-obsidian mt-1">Chicken Breast Avocado Bowl</h4>
              </div>
              <span class="text-xs font-bold text-brand-emerald">Rp 58K</span>
            </div>

            <!-- Macro Badges -->
            <div class="grid grid-cols-3 gap-1 text-[9px] font-mono text-center">
              <div class="bg-slate-100 p-1 rounded font-bold text-slate-700">36g Protein</div>
              <div class="bg-amber-50 p-1 rounded font-bold text-amber-800">420 kcal</div>
              <div class="bg-blue-50 p-1 rounded font-bold text-blue-800">28g Karbo</div>
            </div>
            
            <div class="flex gap-1.5 pt-1">
              <span class="text-[8px] font-semibold px-1.5 py-0.5 bg-emerald-50 text-brand-emerald rounded border border-emerald-100">Gym Choice</span>
              <span class="text-[8px] font-semibold px-1.5 py-0.5 bg-purple-50 text-purple-700 rounded border border-purple-100">Keto Friendly</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 3: Medium (Span 1 column) - Table Service Buttons -->
      <div class="bg-white rounded-2xl border border-slate-200/80 p-8 shadow-sm flex flex-col justify-between group hover:shadow-md transition-all duration-300">
        <div>
          <span class="inline-flex items-center justify-center h-10 w-10 rounded-xl bg-blue-50 text-blue-600 border border-blue-100 mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5.5 h-5.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.008v.008H9V10zm3 0h.008v.008H12V10zm3 0h.008v.008H15V10zM12 21a9.003 9.003 0 008.312-5.555M12 21a9.003 9.003 0 01-8.312-5.555M12 21c-1.724 0-3.19-.949-3.9-2.35m8.312-3.205c.974-1.2 1.568-2.73 1.568-4.405a9.003 9.003 0 00-15.312-6.223M3.238 8.113C3.083 8.71 3 9.34 3 10c0 1.675.594 3.205 1.568 4.405M15.9 18.65c-.71 1.4-2.176 2.35-3.9 2.35z" />
            </svg>
          </span>
          <h3 class="text-xl font-bold text-brand-obsidian">Layanan Meja Cepat</h3>
          <p class="text-slate-500 text-sm mt-2">
            Satu ketukan tombol untuk memanggil staf, minta alat makan ekstra, minta bill, atau bertanya rekomendasi langsung.
          </p>
        </div>

        <!-- Tactile Button Panel Mockup -->
        <div class="mt-8 grid grid-cols-2 gap-2.5">
          <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-3 flex flex-col justify-between min-h-[70px] hover:border-slate-350 transition-colors">
            <span class="text-[9px] font-bold text-slate-400 uppercase">Pelayan</span>
            <span class="text-xs font-extrabold text-brand-obsidian">Panggil</span>
          </div>
          <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-3 flex flex-col justify-between min-h-[70px]">
            <span class="text-[9px] font-bold text-slate-400 uppercase">Alat Makan</span>
            <span class="text-xs font-extrabold text-brand-obsidian">Minta Sendok</span>
          </div>
          <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-3 flex flex-col justify-between min-h-[70px]">
            <span class="text-[9px] font-bold text-slate-400 uppercase">Metode</span>
            <span class="text-xs font-extrabold text-brand-obsidian">Bawa Bill</span>
          </div>
          <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-3 flex flex-col justify-between min-h-[70px]">
            <span class="text-[9px] font-bold text-brand-emerald uppercase">Status</span>
            <span class="text-xs font-extrabold text-brand-emerald">Diproses</span>
          </div>
        </div>
      </div>

      <!-- Card 4: Large (Span 2 columns) - POS Printer & Kitchen Sync -->
      <div class="md:col-span-2 bg-white rounded-2xl border border-slate-200/80 p-8 shadow-sm flex flex-col justify-between group hover:shadow-md transition-all duration-300">
        <div>
          <span class="inline-flex items-center justify-center h-10 w-10 rounded-xl bg-purple-50 text-purple-600 border border-purple-100 mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5.5 h-5.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
            </svg>
          </span>
          <h3 class="text-xl font-bold text-brand-obsidian">Integrasi POS & KDS Dapur Real-Time</h3>
          <p class="text-slate-500 text-sm mt-2 max-w-lg">
            Hubungkan pesanan meja langsung ke mesin kasir POS (Moka, Pawoon, dll) dan layar dapur (KDS) kurang dari 1 detik lengkap dengan catatan gizi kustom.
          </p>
        </div>

        <!-- Sync Architecture Flowchart -->
        <div class="mt-8 bg-slate-50 rounded-xl p-5 border border-slate-200/50">
          <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
            
            {/* Step 1: Tablet AI */}
            <div class="bg-white rounded-lg p-3 border border-slate-200/60 shadow-sm flex items-center gap-2.5 w-full sm:w-auto text-left">
              <div class="h-8 w-8 rounded bg-brand-emerald/10 flex items-center justify-center text-brand-emerald">
                <span class="font-extrabold text-xs">AI</span>
              </div>
              <div>
                <div class="text-[10px] font-bold text-brand-obsidian">Tablet Meja</div>
                <div class="text-[9px] text-slate-400 font-medium">Asisten Suara RAG</div>
              </div>
            </div>

            {/* Sync Line */}
            <div class="hidden sm:flex flex-col items-center justify-center flex-1">
              <span class="text-[8px] font-bold text-brand-emerald bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100 mb-1">0.8 Detik</span>
              <div class="h-0.5 w-full bg-emerald-200 relative">
                <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 h-1.5 w-1.5 rounded-full bg-brand-emerald animate-ping"></div>
              </div>
            </div>

            {/* Step 2: KDS */}
            <div class="bg-white rounded-lg p-3 border border-slate-200/60 shadow-sm flex items-center gap-2.5 w-full sm:w-auto text-left">
              <div class="h-8 w-8 rounded bg-brand-amber/10 flex items-center justify-center text-brand-amber">
                <span class="font-extrabold text-xs">KDS</span>
              </div>
              <div>
                <div class="text-[10px] font-bold text-brand-obsidian">Layar Dapur</div>
                <div class="text-[9px] text-slate-400 font-medium">Order + Gizi Spec</div>
              </div>
            </div>

            {/* Sync Line */}
            <div class="hidden sm:flex flex-col items-center justify-center flex-1">
              <span class="text-[8px] font-bold text-brand-emerald bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100 mb-1">Instan</span>
              <div class="h-0.5 w-full bg-emerald-200"></div>
            </div>

            {/* Step 3: POS */}
            <div class="bg-white rounded-lg p-3 border border-slate-200/60 shadow-sm flex items-center gap-2.5 w-full sm:w-auto text-left">
              <div class="h-8 w-8 rounded bg-brand-obsidian/10 flex items-center justify-center text-brand-obsidian">
                <span class="font-extrabold text-xs">POS</span>
              </div>
              <div>
                <div class="text-[10px] font-bold text-brand-obsidian">Mesin Kasir</div>
                <div class="text-[9px] text-slate-400 font-medium">Auto-Sync Billing</div>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>
