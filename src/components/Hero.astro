---
import DeviceMockup from './DeviceMockup.jsx';
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden bg-slate-50">
  <!-- Subtle light canvas design grid lines (highly premium style) -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#e2e8f0_1px,transparent_1px),linear-gradient(to_bottom,#e2e8f0_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-30 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <!-- Left Column - Text Details -->
      <div class="lg:col-span-7 space-y-6 md:space-y-8 text-left">
        <!-- Emerald pill badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-200/80 text-brand-emerald text-xs md:text-sm font-semibold tracking-wide">
          <span class="flex h-2 w-2 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-emerald opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-emerald"></span>
          </span>
          ✨ #1 Voice AI Table Assistant di Indonesia
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-brand-obsidian leading-[1.1] tracking-tight">
          Otomatisasi Pesanan Meja Resto Lu Pakai <span class="text-brand-emerald">AI Voice di Tiap Meja.</span>
        </h1>

        <!-- Subheadline -->
        <p class="text-base sm:text-lg text-slate-600 max-w-2xl font-medium leading-relaxed">
          Taruh tablet pintar ServePoint di tiap meja makan. Pelanggan cukup bicara langsung ke tablet untuk memesan. AI otomatis mencatat, kirim order ke dapur, dan sinkronisasi billing kasir tanpa antrean.
        </p>

        <!-- Dual CTAs -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
          <a 
            href="#cta-form" 
            class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-brand-amber hover:bg-brand-amber-hover text-white font-bold shadow-md transition-all duration-200 hover:scale-[1.02] active:scale-[0.98]"
          >
            Jadwalkan Demo Gratis
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4.5 h-4.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a 
            href="#ekosistem" 
            class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl border border-slate-200 hover:border-slate-400 bg-white hover:bg-slate-50 text-slate-700 font-bold transition-all duration-200 active:scale-[0.98]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-slate-500">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
            </svg>
            Lihat Cara Kerja
          </a>
        </div>

        <!-- Micro-copy -->
        <div class="pt-4 border-t border-slate-200/60 max-w-xl">
          <div class="flex flex-wrap items-center gap-y-2 gap-x-6 text-xs md:text-sm font-semibold text-slate-500">
            <span class="flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-4 h-4 text-brand-emerald">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              Tanpa Kontrak Mengikat
            </span>
            <span class="flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-4 h-4 text-brand-emerald">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              Integrasi POS 15 Menit
            </span>
            <span class="flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-4 h-4 text-brand-emerald">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              Support 24/7
            </span>
          </div>
        </div>
      </div>

      <!-- Right Column - Interactive Island -->
      <div class="lg:col-span-5 w-full relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <DeviceMockup client:load />
        </div>
      </div>
    </div>
  </div>
</section>
