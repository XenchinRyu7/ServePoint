---
---
<section class="py-12 bg-white border-y border-slate-200/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-xs font-bold tracking-widest text-slate-400 uppercase">
        Dipercaya oleh 50+ Kafe & Restoran Kekinian di Seluruh Indonesia
      </h2>
    </div>
    
    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-12 gap-y-6 md:gap-x-16 lg:gap-x-20 opacity-50">
      <!-- Logo 1: Kopi Kancil -->
      <div class="flex items-center gap-1.5 grayscale hover:grayscale-0 transition-all duration-300">
        <span class="text-slate-800 font-extrabold tracking-tighter text-lg md:text-xl">KOPI</span>
        <span class="bg-slate-800 text-white font-semibold text-xs px-1.5 py-0.5 rounded-sm">KANCIL</span>
      </div>

      <!-- Logo 2: Forefront Coffee -->
      <div class="flex items-center gap-1.5 grayscale hover:grayscale-0 transition-all duration-300">
        <svg class="h-6 w-6 text-slate-800" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          <path d="M2 17L12 22L22 17" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          <path d="M2 12L12 17L22 12" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
        </svg>
        <span class="text-slate-800 font-bold tracking-tight text-base md:text-lg">forefront</span>
      </div>

      <!-- Logo 3: Union & Co -->
      <div class="flex items-center gap-1 grayscale hover:grayscale-0 transition-all duration-300">
        <span class="text-slate-850 font-serif font-black tracking-tight text-xl md:text-2xl">UNION</span>
        <span class="text-slate-500 font-light text-xs tracking-wider">& CO</span>
      </div>

      <!-- Logo 4: Bakmi Chef -->
      <div class="flex items-center gap-2 grayscale hover:grayscale-0 transition-all duration-300">
        <span class="text-slate-800 font-sans font-black italic tracking-tight text-lg md:text-xl">BAKMI</span>
        <div class="h-4.5 w-0.5 bg-slate-400"></div>
        <span class="text-slate-700 font-medium text-sm tracking-wide">chef.</span>
      </div>

      <!-- Logo 5: Common Grounds -->
      <div class="flex items-center gap-1.5 grayscale hover:grayscale-0 transition-all duration-300">
        <div class="w-6 h-6 border-2 border-slate-800 rounded-full flex items-center justify-center">
          <span class="text-[10px] font-bold text-slate-800">C</span>
        </div>
        <span class="text-slate-800 font-semibold tracking-wide text-xs uppercase">Common Grounds</span>
      </div>

      <!-- Logo 6: Jurnal Roti -->
      <div class="flex items-center gap-1.5 grayscale hover:grayscale-0 transition-all duration-300">
        <span class="text-slate-800 font-medium tracking-tight text-sm">jurnal</span>
        <span class="text-slate-850 font-extrabold tracking-tighter text-base md:text-lg bg-slate-100 border border-slate-200 px-1 py-0.2 rounded">ROTI</span>
      </div>
    </div>
  </div>
</section>
