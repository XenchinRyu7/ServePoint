---
---
<section id="cta-form" class="py-16 md:py-24 bg-slate-50 relative overflow-hidden">
  <!-- Subtle line mesh backgrounds -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#e2e8f0_1px,transparent_1px),linear-gradient(to_bottom,#e2e8f0_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_100%,#000_70%,transparent_100%)] opacity-30 pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="bg-brand-obsidian rounded-3xl border border-slate-800 p-8 md:p-12 lg:p-16 shadow-xl grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column - Text Details -->
      <div class="lg:col-span-6 space-y-6 text-left">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-950/60 border border-brand-emerald/40 text-brand-emerald text-xs font-bold uppercase tracking-wider">
          🚀 SLOT TERBATAS
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white leading-tight tracking-tight">
          Siap Modernisasi Resto Anda & Tingkatkan Turnover Meja?
        </h2>
        <p class="text-slate-400 text-sm md:text-base leading-relaxed font-medium">
          Dapatkan gratis biaya instalasi, hardware mounting bracket, dan integrasi POS senilai <strong class="text-white">Rp 3.500.000</strong> khusus untuk 10 pendaftar pertama bulan ini di kota Anda.
        </p>

        <!-- Bullet List -->
        <ul class="space-y-3.5 text-slate-350 text-xs md:text-sm font-semibold">
          <li class="flex items-center gap-3 text-slate-300">
            <span class="h-5 w-5 rounded-full bg-brand-emerald/10 border border-brand-emerald/30 flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3.5" stroke="currentColor" class="w-3 h-3 text-brand-emerald">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
            </span>
            Kunjungan survey & uji coba gratis di tempat
          </li>
          <li class="flex items-center gap-3 text-slate-300">
            <span class="h-5 w-5 rounded-full bg-brand-emerald/10 border border-brand-emerald/30 flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3.5" stroke="currentColor" class="w-3 h-3 text-brand-emerald">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
            </span>
            Integrasi langsung ke POS kasir yang Anda pakai
          </li>
          <li class="flex items-center gap-3 text-slate-300">
            <span class="h-5 w-5 rounded-full bg-brand-emerald/10 border border-brand-emerald/30 flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3.5" stroke="currentColor" class="w-3 h-3 text-brand-emerald">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
            </span>
            Tanpa komitmen kontrak jangka panjang
          </li>
        </ul>
      </div>

      <!-- Right Column - Leads Capture Form -->
      <div class="lg:col-span-6 w-full bg-brand-obsidian-light border border-slate-800 rounded-2xl p-6 md:p-8 shadow-inner relative">
        <div id="form-container">
          <form id="lead-capture-form" class="space-y-4 text-left">
            
            <!-- Input 1: Nama Pemilik -->
            <div>
              <label for="owner-name" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Nama Pemilik / Pengelola</label>
              <input 
                type="text" 
                id="owner-name" 
                required 
                placeholder="Contoh: Budi Santoso" 
                class="w-full bg-[#090D16] border border-slate-850 hover:border-slate-700 focus:border-brand-emerald text-white rounded-xl px-4 py-3 text-xs md:text-sm font-semibold outline-none transition-colors"
              />
            </div>

            <!-- Input 2: Nama Resto -->
            <div>
              <label for="restaurant-name" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Nama Kafe / Restoran</label>
              <input 
                type="text" 
                id="restaurant-name" 
                required 
                placeholder="Contoh: Forefront Coffee Menteng" 
                class="w-full bg-[#090D16] border border-slate-850 hover:border-slate-700 focus:border-brand-emerald text-white rounded-xl px-4 py-3 text-xs md:text-sm font-semibold outline-none transition-colors"
              />
            </div>

            <!-- Input 3 & 4 Grid: Kota & WhatsApp -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="city" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Kota</label>
                <input 
                  type="text" 
                  id="city" 
                  required 
                  placeholder="Contoh: Jakarta Pusat" 
                  class="w-full bg-[#090D16] border border-slate-850 hover:border-slate-700 focus:border-brand-emerald text-white rounded-xl px-4 py-3 text-xs md:text-sm font-semibold outline-none transition-colors"
                />
              </div>
              <div>
                <label for="whatsapp" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Nomor WhatsApp</label>
                <input 
                  type="tel" 
                  id="whatsapp" 
                  required 
                  placeholder="Contoh: 08123456789" 
                  class="w-full bg-[#090D16] border border-slate-850 hover:border-slate-700 focus:border-brand-emerald text-white rounded-xl px-4 py-3 text-xs md:text-sm font-semibold outline-none transition-colors"
                />
              </div>
            </div>

            <!-- Submit Button -->
            <button 
              type="submit" 
              class="w-full py-4 px-6 bg-brand-orange hover:bg-brand-amber text-white text-xs md:text-sm font-extrabold uppercase tracking-wider rounded-xl transition-all duration-200 hover:scale-[1.01] active:scale-[0.99] shadow-md shadow-orange-950/40 mt-2"
            >
              Minta Demo & Penawaran Spesial
            </button>

            <span class="text-[10px] text-center text-slate-500 font-medium block mt-3">
              🔒 Data Anda aman. Tim kami akan menghubungi via WhatsApp dalam waktu maksimal 1 jam.
            </span>

          </form>
        </div>

        {/* Success State Overlay container (initially hidden) */}
        <div id="success-container" class="hidden absolute inset-0 bg-brand-obsidian-light rounded-2xl p-6 md:p-8 flex flex-col items-center justify-center text-center space-y-4 animate-fade-in z-20">
          <div class="h-16 w-16 bg-emerald-500/10 border border-brand-emerald/30 rounded-full flex items-center justify-center text-brand-emerald shadow-inner">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-8 h-8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
            </svg>
          </div>
          <h3 class="text-xl font-extrabold text-white">Registrasi Berhasil!</h3>
          <p class="text-xs md:text-sm text-slate-400 max-w-sm">
            Terima kasih <strong class="text-white" id="success-owner">Budi</strong>. Tiket promo untuk <strong class="text-white" id="success-resto">Kafe</strong> telah kami amankan. Konsultan ServePoint akan menghubungi WhatsApp Anda di <strong class="text-white" id="success-phone">0812</strong> sebentar lagi.
          </p>
          <a 
            id="wa-direct-link"
            href="https://wa.me/628123456789"
            target="_blank" 
            class="inline-flex items-center gap-2 py-3 px-6 bg-brand-emerald hover:bg-brand-emerald-hover text-white text-xs font-bold uppercase tracking-wider rounded-xl shadow transition-colors"
          >
            Hubungi via WA Direct
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>

      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('lead-capture-form') as HTMLFormElement;
  const formContainer = document.getElementById('form-container');
  const successContainer = document.getElementById('success-container');
  
  const successOwner = document.getElementById('success-owner');
  const successResto = document.getElementById('success-resto');
  const successPhone = document.getElementById('success-phone');
  const waLink = document.getElementById('wa-direct-link') as HTMLAnchorElement;

  if (form && formContainer && successContainer && successOwner && successResto && successPhone && waLink) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const ownerVal = (document.getElementById('owner-name') as HTMLInputElement).value;
      const restoVal = (document.getElementById('restaurant-name') as HTMLInputElement).value;
      const cityVal = (document.getElementById('city') as HTMLInputElement).value;
      const phoneVal = (document.getElementById('whatsapp') as HTMLInputElement).value;

      // Populate success text
      successOwner.textContent = ownerVal;
      successResto.textContent = restoVal;
      successPhone.textContent = phoneVal;
      
      // Format WA text link
      const text = encodeURIComponent(`Halo ServePoint, saya ${ownerVal} pemilik ${restoVal} di ${cityVal}. Saya tertarik dengan promo setup gratis hardware & POS.`);
      waLink.href = `https://wa.me/6281290008000?text=${text}`; // Dummy sales hotline

      // Swap layout containers
      successContainer.classList.remove('hidden');
    });
  }
</script>
